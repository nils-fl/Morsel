{
  "name": "morsel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "boot-gif": "node scripts/boot-gif.mjs",
    "kits": "node scripts/make-kits.mjs",
    "ableton-ref": "node scripts/ableton-ref.mjs",
    "measure": "node scripts/measure-morsel.mjs && node scripts/compare-sounds.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview:worker": "npm run build && wrangler dev",
    "og-image": "node scripts/og-image.mjs",
    "desktop:dev": "node scripts/electron.mjs dev",
    "desktop:build": "npm run build && node scripts/electron.mjs build",
    "desktop:dist": "npm run desktop:build && electron-builder --mac --config electron/builder.yml"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "node-web-audio-api": "^2.2.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "productName": "Morsel",
  "main": "dist-electron/main.cjs"
}
